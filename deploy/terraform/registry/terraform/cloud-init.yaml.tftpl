#cloud-config
package_update: false
package_upgrade: false

write_files:
  - path: /root/setup-registry.sh
    permissions: "0755"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail
      mkdir -p /opt/registry/{auth,config,caddy}
      cd /opt/registry

      # Basic Auth Hash
      apt-get update && apt-get install -y apache2-utils git || true
      HUSER="${registry_user}"
      HPASS="${registry_pass}"
      htpasswd -Bbn "$HUSER" "$HPASS" > auth/htpasswd
      HASH="$(cut -d: -f2 auth/htpasswd)"

      # Cloudflare Token in Envfile
      echo "CLOUDFLARE_API_TOKEN=${cf_api_token}" > .env.caddy
      chmod 600 .env.caddy

      # Registry-Konfig (S3)
      cat > config/config.yml <<'CFG'
      version: 0.1
      log:
        level: info
      http:
        addr: :5000
      storage:
        delete:
          enabled: true      
        s3:
          accesskey: "${s3_access}"
          secretkey: "${s3_secret}"
          region: "${s3_region}"
          regionendpoint: "${s3_endpoint}"
          bucket: "${s3_bucket}"
          encrypt: ${s3_encrypt}
          secure: true
          v4auth: true
          chunksize: 5242880
          rootdirectory: "/"
          forcepathstyle: ${s3_forceps}
      compatibility:
        schema1:
          enabled: true
      CFG

      # Caddy mit Cloudflare-DNS Plugin bauen (xcaddy)
      mkdir -p caddy
      cat > caddy/Dockerfile <<'DOCKER'
      FROM caddy:2-builder AS builder
      RUN xcaddy build --with github.com/caddy-dns/cloudflare
      FROM caddy:2
      COPY --from=builder /usr/bin/caddy /usr/bin/caddy
      DOCKER

      # Compose & Caddyfile
      cat > docker-compose.yml <<'COMPOSE'
      services:
        caddy:
          build: ./caddy
          container_name: caddy
          restart: unless-stopped
          ports:
            - "443:443"
          env_file:
            - ./.env.caddy
          volumes:
            - ./Caddyfile:/etc/caddy/Caddyfile:ro
            - caddy_data:/data
            - caddy_config:/config

        registry:
          image: registry:2
          container_name: registry
          restart: unless-stopped
          environment:
            REGISTRY_HTTP_ADDR: 0.0.0.0:5000
          volumes:
            - ./config/config.yml:/etc/docker/registry/config.yml:ro
          expose:
            - "5000"

      volumes:
        caddy_data:
        caddy_config:
      COMPOSE

      # Caddyfile mit DNS-01 (Terraform-Variablen + Shell-Variablen)
      if [ -n "${registry_domain}" ]; then
        cat > Caddyfile <<CADDY
      {
        email ${acme_email}
      }

      ${registry_domain} {
        encode gzip
        @api path /v2/*

        basicauth @api {
          $${HUSER} $${HASH}
        }

        handle @api {
          reverse_proxy registry:5000
        }

        tls {
          dns cloudflare {\$CLOUDFLARE_API_TOKEN}
        }
      }
      CADDY
      else
        cat > Caddyfile <<'CADDY'
      :443 {
        respond "Bitte 'registry_domain' setzen, um TLS via DNS-01 zu aktivieren." 200
      }
      CADDY
      fi

      # Start
      systemctl daemon-reload
      systemctl enable registry-stack.service || true
      /usr/bin/docker compose -f /opt/registry/docker-compose.yml build
      /usr/bin/docker compose -f /opt/registry/docker-compose.yml up -d
      systemctl restart registry-stack.service || true
runcmd:
  - [ /usr/bin/env, bash, -lc, "/root/setup-registry.sh" ]
  