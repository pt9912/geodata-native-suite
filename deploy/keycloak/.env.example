
# --- Keycloak connection ---
KEYCLOAK_URL=http://localhost:8080
REALM=geodata
ADMIN_USER=admin
ADMIN_PASSWORD=admin
KEYCLOAK_VERSION=25.0.0

# --- Realm bootstrap settings ---
REALM_DISPLAY_NAME=GeoData
ALLOW_USER_REGISTRATION=false
LOGIN_WITH_EMAIL=true
REQUIRE_EMAIL_VERIFICATION=true

# SMTP (for email verification, forgot password)
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_FROM=noreply@auth.geo-terrain.net
SMTP_USER=smtp-user
SMTP_PASSWORD=smtp-password
SMTP_ENCRYPTION=starttls   # none|starttls|ssl

# Default realm roles (comma/semicolon separated)
DEFAULT_ROLES=user

# Create extra realm roles (in addition to DEFAULT_ROLES)
EXTRA_ROLES=user;analyst;viewer;admin

# --- Clients ---
# UI (public) client
UI_CLIENT_ID=geodata-ui
UI_REDIRECTS=https://ui.prod.data.geo-terrain.net/*,http://localhost:5173/*
UI_WEB_ORIGINS=https://ui.prod.data.geo-terrain.net,http://localhost:5173

# API (confidential) client (service accounts enabled)
API_CLIENT_ID=geodata-api
API_BASE_URL=https://api.prod.data.geo-terrain.net
API_ALLOWED_ORIGINS=https://ui.prod.data.geo-terrain.net,http://localhost:5173

# CLI (public) client
CLI_CLIENT_ID=geodata-cli
CLI_REDIRECTS=http://localhost/*

# --- 2FA (OTP) ---
OTP_POLICY_ALG=HmacSHA1       # HmacSHA1|HmacSHA256|HmacSHA512
OTP_POLICY_DIGITS=6
OTP_POLICY_PERIOD=30
OTP_POLICY_TYPE=totp          # totp|hotp
ENFORCE_TOTP=true

# Built-in required actions to enable (comma/semicolon list)
REQUIRED_ACTIONS=VERIFY_EMAIL,UPDATE_PASSWORD,CONFIGURE_TOTP

# --- Groups (optional) ---
GROUPS=analyst,viewer,admin
DEFAULT_GROUPS=viewer
