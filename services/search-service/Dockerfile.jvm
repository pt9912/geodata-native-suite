# ---- Stage 0: Build (creates wrapper + builds fat jar) ----
FROM gradle:8.8-jdk21 AS build
WORKDIR /workspace
COPY . .
# Generate wrapper deterministically (in case it's not in repo)
RUN gradle -q wrapper --gradle-version 8.8
# Use wrapper for the build (repeatable & pinned), disable tests for speed
RUN chmod +x ./gradlew && \
    ./gradlew --no-daemon --stacktrace --warning-mode all clean shadowJar

# ---- Stage 1: Runtime (JRE21) ----
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
# Copy fat jar (name pattern: *-all.jar from Shadow plugin)
COPY --from=build /workspace/build/libs/*-all.jar /app/application.jar
ENV JAVA_OPTS=""
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/application.jar"]
