# Native build using GraalVM container toolchain
## GRAALVM BASE CANDIDATES (workflow probes):
##  - ghcr.io/graalvm/native-image:ol9-java21-24.1.0
##  - ghcr.io/graalvm/native-image:ol9-java21-24.0.2
##  - ghcr.io/graalvm/native-image:ol9-java21-24
##  - ghcr.io/graalvm/native-image:ol9-java21-23.1.3
ARG BASE_IMAGE=ghcr.io/graalvm/native-image-community:24.0.1-ol9
FROM ${BASE_IMAGE} AS build
WORKDIR /work
RUN java -version && echo "JAVA_HOME=$JAVA_HOME" && which java
ENV JAVA_HOME=/usr/lib64/graalvm/graalvm-java21
ENV PATH=\$JAVA_HOME/bin:\$PATH
COPY . .
# Build native image (force JDK21, wrapper only)
RUN chmod +x ./gradlew 2>/dev/null || true \
 && JAVA_HOME=$JAVA_HOME PATH=$JAVA_HOME/bin:$PATH ./gradlew -x test nativeCompile \
 || (echo 'Gradle Wrapper fehlt. Bitte gradlew committen.' >&2; exit 2)
