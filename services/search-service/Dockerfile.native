#https://github.com/graalvm/container/pkgs/container/native-image-community/versions?filters%5Bversion_type%5D=tagged
#ARG BASE_IMAGE=ghcr.io/graalvm/native-image-community:21-ol9
ARG BASE_IMAGE=ghcr.io/graalvm/native-image-community:24.0.2-ol9


# Stage 0: bootstrap gradle wrapper (no network tools needed in Graal stage)
FROM gradle:8.8-jdk21 AS bootstrap
WORKDIR /src
COPY . .
RUN gradle -q wrapper --gradle-version 8.8

# Stage 1: native-image build using GraalVM CE JDK21
FROM ${BASE_IMAGE} AS build

RUN microdnf install findutils


WORKDIR /work
ENV JAVA_HOME=/usr/lib64/graalvm/graalvm-community-java21
ENV PATH=$JAVA_HOME/bin:$PATH
# copy wrapper from bootstrap
COPY --from=bootstrap /src/gradlew ./gradlew
COPY --from=bootstrap /src/gradle/wrapper ./gradle/wrapper
# copy sources last for better layer caching
COPY . .
RUN java -version && echo "JAVA_HOME=$JAVA_HOME" && command -v java || true
# Build native image via wrapper (no tests)
RUN chmod +x ./gradlew \
 && JAVA_HOME=$JAVA_HOME PATH=$JAVA_HOME/bin:$PATH ./gradlew -x test nativeCompile

# Stage 2: minimal runtime image
FROM gcr.io/distroless/base-nossl:nonroot
WORKDIR /app
COPY --from=build /work/build/native/nativeCompile/* /app/
USER nonroot
EXPOSE 8080
ENTRYPOINT ["/app/application"]
