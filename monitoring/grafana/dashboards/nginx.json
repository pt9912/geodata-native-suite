{"id": null, "title": "NGINX Download/Cache", "schemaVersion": 39, "version": 1, "panels": [{"type": "stat", "title": "Req/s", "id": 1, "targets": [{"expr": "sum(rate(nginx_http_response_count[1m]))"}]}, {"type": "gauge", "title": "2xx Rate", "id": 2, "targets": [{"expr": "sum(rate(nginx_http_response_count{status=~\"2..\"}[5m])) / clamp_min(sum(rate(nginx_http_response_count[5m])),1)"}]}, {"type": "timeseries", "title": "Request p95 (s)", "id": 3, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(nginx_request_time_seconds_bucket[5m])) by (le))"}]}, {"type": "timeseries", "title": "Upstream p95 (s)", "id": 4, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(nginx_upstream_time_seconds_bucket[5m])) by (le))"}]}, {"type": "timeseries", "title": "Bandwidth (bytes/s)", "id": 5, "targets": [{"expr": "rate(nginx_http_response_size_bytes_sum[1m])"}]}, {"type": "timeseries", "title": "Status Codes", "id": 6, "targets": [{"expr": "sum by (status) (rate(nginx_http_response_count[1m]))"}]}]}
